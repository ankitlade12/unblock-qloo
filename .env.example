# Optional. Leave empty for the synthetic walkthrough.
QLOO_API_KEY=
QLOO_API_ORIGIN=https://hackathon.api.qloo.com
QLOO_CALL_BUDGET=40
# Optional tool-calling language model. Choose a Responses-compatible model available to your account.
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_ORIGIN=https://api.openai.com
# Local defaults. For HTTPS hosting set COOKIE_SECURE=true and APP_ORIGIN to the exact public origin.
APP_ORIGIN=http://127.0.0.1:8011
COOKIE_SECURE=false
DATABASE_PATH=data/unblock.db
PORT=8011

# Durable deployment-wide attempt caps per UTC day (all workspaces combined).
QLOO_DAILY_CALL_BUDGET=200
MODEL_DAILY_CALL_BUDGET=100
